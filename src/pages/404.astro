---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Page not found — ${SITE_TITLE}`} description="This page could not be found." />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <Header />
    <main id="main">
      <p class="date">404</p>
      <h1>Page not found.</h1>
      <p>This page may have moved, or may not exist.</p>
      <p><a href="/">Return to the essays</a></p>
    </main>
  </body>
</html>
